# =============================================================================
# FOX AI SOCIAL — environment template
# Copy to .env and fill in only the sections you enable:  cp .env.example .env
#
# Every variable below is either read by `process.env.*` in src/ or interpolated
# by docker-compose.yml. Nothing else is loaded.
# NEVER commit .env — it is listed in .gitignore.
# =============================================================================

# -----------------------------------------------------------------------------
# Core
# -----------------------------------------------------------------------------
NODE_ENV=production

# Internal port the Next.js server binds to (Dockerfile / docker-compose).
PORT=3000

# Public origin, NO trailing slash. Used for CSRF/origin checks in
# src/lib/auth.ts and to build the Telegram webhook URL.
APP_URL=https://your-domain.example.com

# PostgreSQL connection string (read by src/db/index.ts).
# Matches the `db` service created by docker-compose.yml.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fox_ai_social

# -----------------------------------------------------------------------------
# Security — all three are REQUIRED in production
# Without them the app silently falls back to insecure hard-coded dev keys
# ("fox-ai-social-insecure-dev-secret" / "fox-ai-social-dev-secret-key").
# Generate with:  openssl rand -base64 48
# -----------------------------------------------------------------------------
# Signs session JWTs (HS256).
AUTH_SECRET=

# Fallback signing key used when AUTH_SECRET is absent — set it anyway.
JWT_SECRET=

# AES-256-GCM key that encrypts social tokens and AI provider keys at rest.
# Rotating it invalidates every already-stored credential.
ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# AI providers (src/lib/ai/gateway.ts)
# Routing is priority-ordered: OMNIROUTE -> ARENA -> OPENROUTER.
# A provider is enabled only when BOTH its URL and API key are set.
# Base URLs must point at the API root — the gateway appends /chat/completions.
# -----------------------------------------------------------------------------
OMNIROUTE_URL=
OMNIROUTE_API_KEY=
OMNIROUTE_MODEL=gpt-4o-mini
OMNIROUTE_TIMEOUT_MS=60000

ARENA_API_URL=
ARENA_API_KEY=
ARENA_MODEL=gpt-4o-mini
ARENA_TIMEOUT_MS=60000

OPENROUTER_URL=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_TIMEOUT_MS=60000

# -----------------------------------------------------------------------------
# Google Sheets (src/lib/sheets/google.ts)
# -----------------------------------------------------------------------------
# Spreadsheet ID taken from the sheet URL.
GOOGLE_SHEETS_ID=

# The FULL service-account JSON, collapsed onto ONE line with \n escapes.
GOOGLE_SERVICE_ACCOUNT=

# -----------------------------------------------------------------------------
# Telegram (src/lib/publishing/telegram.ts, /api/telegram/webhook)
# -----------------------------------------------------------------------------
# Token from @BotFather. Used as a global fallback when a client's connected
# account has no token of its own.
TELEGRAM_BOT_TOKEN=

# Optional X-Telegram-Bot-Api-Secret-Token validated on incoming updates.
TELEGRAM_WEBHOOK_SECRET=

# Passed through by docker-compose only; the app derives the URL from APP_URL
# (APP_URL + /api/telegram/webhook), so this is informational.
TELEGRAM_WEBHOOK_URL=

# -----------------------------------------------------------------------------
# Meta — Facebook / Instagram
# -----------------------------------------------------------------------------
# NOTE: these are NOT read from the environment by the adapters. Page and
# Instagram Business tokens are stored per social account, encrypted at rest,
# and resolved via resolveToken(). The values below are only surfaced as
# labels in the Integrations UI and passed through by docker-compose.
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=

# -----------------------------------------------------------------------------
# Docker Compose only (docker-compose.yml interpolates these into the services)
# -----------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=fox_ai_social

# -----------------------------------------------------------------------------
# Build-time (Dockerfile)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=https://your-domain.example.com
